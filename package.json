{
	"name": "tmt-actions",
	"version": "0.1.0",
	"description": "GitHub Actions for running tmt",
	"main": "lib/actions/main.js",
	"scripts": {
		"prepare": "husky",
		"build": "tsc",
		"format": "prettier --write '**/*.ts'",
		"format-check": "prettier --check '**/*.ts'",
		"lint": "eslint",
		"package": "ts-node src/scripts/run_ncc.ts",
		"test": "jest",
		"all": "npm run build && npm run format && npm run lint && npm run package && npm test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LecrisUT/tmt-actions"
	},
	"keywords": [
		"actions",
		"node",
		"setup"
	],
	"author": {
		"name": "Cristian Le",
		"email": "git@lecris.dev"
	},
	"license": "MIT",
	"dependencies": {
		"@actions/artifact": "^2.0.0",
		"@actions/core": "^1.10.1",
		"@actions/exec": "^1.1.1",
		"@nexssp/os": "github:LecrisUT/os"
	},
	"devDependencies": {
		"@types/eslint": "^9.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/lint-staged": "^14.0.0",
		"@types/node": "^24.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@vercel/ncc": "^0.45.0",
		"eslint": "^10.0.0",
		"eslint-plugin-github": "^6.0.0",
		"eslint-plugin-jest": "^29.0.0",
		"eslint-plugin-prettier": "^5.1.2",
		"husky": "^9.0.0",
		"jest": "^30.0.0",
		"js-yaml": "^5.0.0",
		"lint-staged": "^17.0.0",
		"npm-check-updates": "^23.0.0",
		"prettier": "^3.1.1",
		"ts-jest": "^29.1.1",
		"ts-node": "^10.9.2",
		"typescript": "^7.0.0"
	},
	"lint-staged": {
		"*.js": "eslint --cache --fix"
	}
}
